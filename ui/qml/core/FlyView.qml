                        color: "#253147"
                        font.pixelSize: 13
                        font.bold: true
                        horizontalAlignment: Text.AlignHCenter
                    }
                }
            }

            function headingLabel(value) {
                var rounded = Math.round(value / 15) * 15
                if (rounded === 0 || rounded === 360)
                    return "N"
                if (rounded === 45)
                    return "NE"
                if (rounded === 90)
                    return "E"
                if (rounded === 135)
                    return "SE"
                if (rounded === 180)
                    return "S"
                if (rounded === 225)
                    return "SW"
                if (rounded === 270)
                    return "W"
                if (rounded === 315)
                    return "NW"
                return rounded
            }
        }

        Rectangle {
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: headingStrip.bottom
            visible: false
            width: 22
            height: 18
            color: "#eef3ff"
