import QtQuick
import QtQuick.Controls
import QtQuick.Dialogs
import QtQuick.Effects
import QtQuick.Layouts
import QtQuick.Window
import Qt.labs.settings
import "../accessories"
import "../map"
import "../panels"
import "../settings"
import "../video"

Item {
    id: root

    property QtObject theme: Palette {}
    property bool darkTheme: theme.darkMode
    property bool videoFocused: false
    property string rtspLink: ""
    property string cameraName: ""
    property string mapViewMode: "satellite"
    readonly property var vehicleManagerObject: typeof vehicleManager !== "undefined" ? vehicleManager : null
    property var vehicle: vehicleManagerObject ? vehicleManagerObject.activeVehicle : null
    readonly property var mavlinkObject: root.vehicle ? root.vehicle.mavlink : null
    readonly property bool vehicleConnected: root.mavlinkObject ? root.mavlinkObject.connected : false
    readonly property var videoObject: root.vehicle ? root.vehicle.video : null
    readonly property bool cameraConnected: root.videoObject && root.videoObject.streaming

    signal cameraLinkRequested(string rtspLink, string cameraName)
    signal themeModeRequested(bool darkTheme)

    readonly property int pipMargin: 20
    readonly property int pipWidth: 320
    readonly property int pipHeight: 180
    readonly property int telemetryPanelMinWidth: 260
    readonly property int telemetryPanelMaxWidth: Math.max(telemetryPanelMinWidth, Math.min(520, width - 240))
    property int rightPanelWidth: 300
    readonly property int bottomBarHeight: 92
    readonly property int gimbalPanelHeight: 118
    readonly property int missionGraphDrawerMinHeight: 128
    readonly property int missionGraphDrawerMaxHeight: Math.max(missionGraphDrawerMinHeight, height - topBar.height - bottomBarHeight - 120)
    property int missionGraphDrawerHeight: missionGraphDrawerMinHeight
    readonly property int pipBottomMargin: pipMargin
    readonly property int videoPipBottomMargin: 28
    readonly property int switchDuration: 160
    property bool switchingViews: false
    property bool instantMapResize: false
    property bool pipWindowOpen: false
    property bool videoPipHidden: false
    readonly property int pipHiddenHandleWidth: 84
    readonly property int pipHiddenHandleHeight: 26
    readonly property int videoPipToggleSize: 34
    readonly property int videoPipTogglePadding: 10
    readonly property color videoControlIconColor: "#f8fbff"
    property string pipWindowContent: ""
    property bool telemetryPanelOpen: false
    property bool telemetryPanelResizing: false
    property bool commandPanelOpen: true
    property string missionUploadDialogText: ""
    property bool missionUploadDialogSuccess: false
    property string uploadedHomeResetDialogText: ""
    property string cameraErrorDialogText: ""
    property string lastCameraErrorText: ""
    property string vehicleCommandDialogText: ""
    property string lastVehicleCommandDialogText: ""
    property bool vehicleCommandDialogError: true
    property bool waitingForArmFailureDetail: false
    property bool waitingForMotorTestFailureDetail: false
    property bool autoGeneratedMissionLoadPending: false
    property string actionStatusText: ""
    property var vehicleMessages: []
    property bool missionGraphOpen: false
    property bool missionGraphResizing: false
    property bool preflightChecklistOpen: false
    property string currentClockText: "--:--"
    property bool oemSettingsOpen: false

    onMissionGraphDrawerMaxHeightChanged: {
        root.missionGraphDrawerHeight = root.clampMissionGraphDrawerHeight(root.missionGraphDrawerHeight)
    }

    onTelemetryPanelMaxWidthChanged: {
        root.rightPanelWidth = root.clampTelemetryPanelWidth(root.rightPanelWidth)
    }

    onVehicleConnectedChanged: {
        if (root.vehicleConnected)
            root.telemetryPanelOpen = true
    }
    onMavlinkObjectChanged: updateJoystickMavlink()

    Component.onCompleted: updateJoystickMavlink()

    Settings {
        id: persistedMapSettings
        category: "Map"
        property alias viewMode: root.mapViewMode
    }
    function showVideoFullScreen() {
        if (root.switchingViews || root.videoFocused || root.pipWindowOpen)
            return
        root.instantMapResize = false
        root.switchingViews = true
        root.videoFocused = true
        switchSettledTimer.restart()
    }

    function showMapFullScreen() {
        if (root.switchingViews || !root.videoFocused || root.pipWindowOpen)
            return
        root.instantMapResize = true
        root.switchingViews = true
        root.videoFocused = false
        switchSettledTimer.restart()
    }

    

    function openPipWindow(content) {
        if (root.pipWindowOpen)
            return

        root.pipWindowContent = content
        root.pipWindowOpen = true
        pipWindow.show()
        pipWindow.raise()
        pipWindow.requestActivate()
    }

    function openMapMissionMenu(mapItem, mapX, mapY) {
        var scenePoint = mapItem.mapToItem(root, mapX, mapY)
        var menuWidth = mapMissionMenu.implicitWidth > 0 ? mapMissionMenu.implicitWidth : 132
        var menuHeight = 118
        mapMissionMenu.x = Math.max(8, Math.min(root.width - menuWidth - 8, scenePoint.x))
        mapMissionMenu.y = Math.max(8, Math.min(root.height - menuHeight - 8, scenePoint.y))
        mapMissionMenu.open()
    }

    function openTelemetryPopout() {
        telemetryPopoutWindow.width = Math.max(root.rightPanelWidth, Math.round(telemetryPanel.width))
        telemetryPopoutWindow.height = Math.max(260, Math.round(telemetryPanel.height))
        telemetryPopoutWindow.show()
        telemetryPopoutWindow.raise()
        telemetryPopoutWindow.requestActivate()
    }

    function openMissionGraphWindow() {
        missionGraphWindow.width = Math.max(720, Math.round(root.width * 0.58))
        missionGraphWindow.height = 280
        missionGraphWindow.show()
        missionGraphWindow.raise()
        missionGraphWindow.requestActivate()
        root.missionGraphOpen = false
    }

    function clampMissionGraphDrawerHeight(value) {
        return Math.max(root.missionGraphDrawerMinHeight,
                        Math.min(root.missionGraphDrawerMaxHeight, Math.round(value)))
    }

    function clampTelemetryPanelWidth(value) {
        return Math.max(root.telemetryPanelMinWidth,
                        Math.min(root.telemetryPanelMaxWidth, Math.round(value)))
    }

    function closePipWindowState() {
        root.pipWindowOpen = false
        root.pipWindowContent = ""
    }

    Timer {
        interval: 1000
        running: true
        repeat: true
        triggeredOnStart: true
        onTriggered: root.currentClockText = root.clockText(new Date())
    }

    function localFileUrl(path) {
        if (!path || path.length === 0)
            return ""

        var normalized = String(path).replace(/\\/g, "/")
        if (normalized.indexOf("file:") === 0)
            return normalized
        if (/^[A-Za-z]:\//.test(normalized))
            return "file:///" + normalized
        if (normalized.charAt(0) === "/")
            return "file://" + normalized
        return normalized
    }

    function loadGeneratedMission(path) {
        if (!root.mavlinkObject || !path || path.length === 0)
            return

        root.autoGeneratedMissionLoadPending = true
        root.mavlinkObject.uploadMissionFile(root.localFileUrl(path))
    }

    function requestVehicleMissionLoad() {
        if (!root.mavlinkObject || !root.vehicleConnected)
            return

        root.mavlinkObject.downloadMissionFromVehicle()
        root.showActionStatus("Vehicle mission load requested")
    }

    function requestVehicleMissionWrite() {
        if (!root.mavlinkObject)
            return

        var hasLoadedMission = root.mavlinkObject.missionWaypoints.length > 0
        if (root.vehicleConnected && hasLoadedMission) {
            if (root.mavlinkObject.writeLoadedMissionToVehicle())
                root.showActionStatus("Mission write requested")
            return
        }

        if (!root.vehicleConnected) {
            root.showActionStatus("Connect vehicle before writing mission")
            return
        }

        mapMissionWriteDialog.open()
        root.showActionStatus("Select mission file to write")
    }

    function requestVehicleMissionClear() {
        if (!root.mavlinkObject)
            return

        root.mavlinkObject.clearMission()
        root.showActionStatus("Mission clear requested")
    }

    function uploadedHomeLocationText() {
        if (!root.mavlinkObject || !root.mavlinkObject.uploadedHomeLocationAvailable)
            return ""

        var home = root.mavlinkObject.uploadedHomeLocation
        var latitude = Number(home.lat)
        var longitude = Number(home.lon)
        var altitude = Number(home.alt)
        if (!isFinite(latitude) || !isFinite(longitude) || !isFinite(altitude))
            return ""

        return "Lat " + latitude.toFixed(7)
                + ", Lon " + longitude.toFixed(7)
                + ", Alt " + altitude.toFixed(1) + " m"
    }

    function openUploadedHomeResetPrompt() {
        if (!root.vehicleConnected || !root.mavlinkObject || !root.mavlinkObject.uploadedHomeLocationAvailable)
            return false

        var coordinatesText = root.uploadedHomeLocationText()
        if (coordinatesText.length === 0)
            return false

        root.uploadedHomeResetDialogText = "Reset the vehicle home location to the uploaded plan coordinates?\n" + coordinatesText
        uploadedHomeResetDialog.open()
        return true
    }

    function confirmUploadedHomeReset() {
        if (!root.mavlinkObject)
            return

        var requested = root.mavlinkObject.resetHomeToUploadedLocation()
        uploadedHomeResetDialog.close()
        if (!requested)
            root.showActionStatus("Home reset was not requested")
    }

    function metersText(value) {
        if (value === undefined || value === null)
            return "-- m"
        return Number(value).toFixed(1) + " m"
    }

    function speedText(value) {
        if (value === undefined || value === null)
            return "-- m/s"
        return Number(value).toFixed(1) + " m/s"
    }

    function degreeText(value) {
        if (value === undefined || value === null)
            return "-- deg"
        return Number(value).toFixed(1) + " deg"
    }

    function radianDegreeText(value) {
        if (value === undefined || value === null)
            return "-- deg"
        return (Number(value) * 180 / Math.PI).toFixed(1) + " deg"
    }

    function percentText(value) {
        if (value === undefined || value === null || value < 0)
            return "-- %"
        return Number(value).toFixed(0) + " %"
    }

    function integerText(value) {
        if (value === undefined || value === null)
            return "--"
        return Number(value).toFixed(0)
    }

    function coordinateText(value) {
        if (value === undefined || value === null)
            return "--"
        return Number(value).toFixed(6)
    }

    function timeText(seconds) {
        if (seconds === undefined || seconds === null)
            return "--:--"
        var totalSeconds = Math.max(0, Math.floor(Number(seconds)))
        var minutes = Math.floor(totalSeconds / 60)
        var remainingSeconds = totalSeconds % 60
        return minutes + ":" + (remainingSeconds < 10 ? "0" : "") + remainingSeconds
    }

    function clockText(date) {
        var hours = date.getHours()
        var minutes = date.getMinutes()
        var seconds = date.getSeconds()
        return (hours < 10 ? "0" : "") + hours + ":"
                + (minutes < 10 ? "0" : "") + minutes + ":"
                + (seconds < 10 ? "0" : "") + seconds
    }

    function showActionStatus(message) {
        if (!message || message.length === 0)
            return

        root.actionStatusText = message
        missionStatusToast.opacity = 1
        missionStatusHideTimer.restart()
    }

    function toggleScreenRecording() {
        if (typeof backend === "undefined" || !backend)
            return

        var wasRecording = backend.screenRecording
        if (backend.toggleScreenRecording(root.Window.window)) {
            root.showActionStatus(wasRecording ? "Screen recording saved" : "Screen recording started")
        } else {
            var errorMessage = backend.screenRecordingError && backend.screenRecordingError.length > 0
                    ? backend.screenRecordingError
                    : "Screen recording failed"
            root.showActionStatus(errorMessage)
        }
    }

    function updateJoystickMavlink() {
        if (typeof backend === "undefined" || !backend)
            return

        backend.setJoystickMavlink(root.mavlinkObject)
    }

    function setJoystickControlEnabled(enabled) {
        if (typeof backend === "undefined" || !backend)
            return

        backend.setJoystickEnabled(enabled)
        root.showActionStatus(enabled ? "Joystick enabled" : "Joystick disabled")
    }

    function classifyVehicleMessage(message, fallbackSeverity) {
        var text = message ? message.toLowerCase() : ""
        if (fallbackSeverity && fallbackSeverity.length > 0)
            return fallbackSeverity
        if (text.indexOf("error") !== -1 || text.indexOf("fail") !== -1 || text.indexOf("denied") !== -1 || text.indexOf("reject") !== -1)
            return "error"
        if (text.indexOf("warn") !== -1 || text.indexOf("low ") !== -1 || text.indexOf("high ") !== -1 || text.indexOf("ekf") !== -1 || text.indexOf("compass") !== -1)
            return "warning"
        return "info"
    }

    function addVehicleMessage(message, severity) {
        if (!message || message.length === 0)
            return

        var now = new Date()
        var nextMessages = root.vehicleMessages.slice()
        nextMessages.unshift({
            "text": message,
            "severity": root.classifyVehicleMessage(message, severity),
            "timestamp": now.getTime(),
            "dateText": Qt.formatDate(now, "M/d/yyyy"),
            "timeText": Qt.formatTime(now, "HH:mm:ss")
        })

        if (nextMessages.length > 200)
            nextMessages = nextMessages.slice(0, 200)
        root.vehicleMessages = nextMessages
    }

    function clearVehicleCommandFailureState() {
        root.waitingForArmFailureDetail = false
        root.waitingForMotorTestFailureDetail = false
        root.lastVehicleCommandDialogText = ""
        if (vehicleCommandDialog.opened)
            vehicleCommandDialog.close()
    }

    function clearArmCommandFailureState() {
        root.waitingForArmFailureDetail = false
        if (root.vehicleCommandDialogError && root.vehicleCommandDialogText.toLowerCase().indexOf("arm") !== -1) {
            root.lastVehicleCommandDialogText = ""
            if (vehicleCommandDialog.opened)
                vehicleCommandDialog.close()
        }
    }

    function isPositiveVehicleStatus(message) {
        var text = message ? message.toLowerCase() : ""
        return text === "arming motors"
                || text === "armed"
                || text === "disarming motors"
                || text === "disarmed"
                || text.indexOf("armed:") === 0
                || text.indexOf("disarmed:") === 0
                || text.indexOf("command accepted") !== -1
    }

    function isArmCommandRequestStatus(message) {
        var text = message ? message.toLowerCase() : ""
        return text === "arm requested"
                || text === "disarm requested"
                || text === "checklist confirmed. arm requested"
    }

    function isArmStatusMessage(message) {
        var text = message ? message.toLowerCase() : ""
        return text === "arming motors"
                || text === "armed"
                || text === "disarming motors"
                || text === "disarmed"
                || text.indexOf("armed:") === 0
                || text.indexOf("disarmed:") === 0
    }

    function isFailureVehicleStatus(message) {
        var text = message ? message.toLowerCase() : ""
        return text.indexOf("fail") !== -1
                || text.indexOf("failed") !== -1
                || text.indexOf("error") !== -1
                || text.indexOf("denied") !== -1
                || text.indexOf("reject") !== -1
                || text.indexOf("prearm") !== -1
                || text.indexOf("pre-arm") !== -1
                || text.indexOf("no ") === 0
                || text.indexOf("not ") !== -1
                || text.indexOf(" no ") !== -1
                || text.indexOf("bad ") !== -1
                || text.indexOf("invalid") !== -1
                || text.indexOf("missing") !== -1
                || text.indexOf("unhealthy") !== -1
    }

    function showVehicleCommandMessage(message, error) {
        if (!message || message.length === 0)
            return
        if (message === root.lastVehicleCommandDialogText && vehicleCommandDialog.opened && root.vehicleCommandDialogError === error)
            return

        root.vehicleCommandDialogError = error
        root.lastVehicleCommandDialogText = message
        root.vehicleCommandDialogText = message
        vehicleCommandDialog.open()
    }

    function showVehicleCommandInfo(message) {
        root.showVehicleCommandMessage(message, false)
    }

    function showVehicleCommandError(message) {
        root.showVehicleCommandMessage(message, true)
    }

    function isArmRelatedVehicleStatus(message) {
        var text = message ? message.toLowerCase() : ""
        return !root.isPositiveVehicleStatus(message)
                && root.isFailureVehicleStatus(message)
                && (text.indexOf("arm") !== -1
                || text.indexOf("prearm") !== -1
                || text.indexOf("pre-arm") !== -1
                || text.indexOf("ekf") !== -1
                || text.indexOf("gps") !== -1
                || text.indexOf("compass") !== -1
                || text.indexOf("safety") !== -1
                || text.indexOf("battery") !== -1
                || text.indexOf("throttle") !== -1
                || text.indexOf("calibration") !== -1
                || text.indexOf("rc") !== -1
                || text.indexOf("fence") !== -1)
    }

    function isMotorTestRelatedVehicleStatus(message) {
        var text = message ? message.toLowerCase() : ""
        return !root.isPositiveVehicleStatus(message)
                && root.isFailureVehicleStatus(message)
                && (text.indexOf("motor") !== -1
                || text.indexOf("servo") !== -1
                || text.indexOf("safety") !== -1
                || text.indexOf("armed") !== -1
                || text.indexOf("disarmed") !== -1
                || text.indexOf("throttle") !== -1
                || text.indexOf("prearm") !== -1
                || text.indexOf("pre-arm") !== -1)
    }

    function showCameraError(message) {
        if (!message || message.length === 0 || message === root.lastCameraErrorText)
            return

        root.lastCameraErrorText = message
        root.cameraErrorDialogText = message
        cameraErrorDialog.open()
    }

    function finiteNumber(value, fallbackValue) {
        var numericValue = Number(value)
        return isFinite(numericValue) ? numericValue : fallbackValue
    }

    function scaleBase(value, step) {
        return Math.floor(root.finiteNumber(value, 0) / step) * step
    }

    function scaleOffset(value, step, spacing) {
        return ((root.finiteNumber(value, 0) - root.scaleBase(value, step)) / step) * spacing
    }

    Timer {
        id: clockTimer
        interval: 1000
        running: true
        repeat: true
        property date currentTime: new Date()
        onTriggered: currentTime = new Date()
    }

    Timer {
        id: switchSettledTimer
        interval: root.switchDuration + 40
        repeat: false
        onTriggered: {
            root.switchingViews = false
            root.instantMapResize = false
        }
    }

    Rectangle {
        anchors.fill: parent
        color: root.darkTheme ? "#11161b" : "#f8fbff"
    }

    Rectangle {
        anchors.fill: parent
        color: root.darkTheme ? "#11161b" : "#f8fbff"
        opacity: root.switchingViews && root.instantMapResize ? 0.42 : 0
        visible: opacity > 0
        z: 25

        Behavior on opacity {
            NumberAnimation {
                duration: root.switchDuration
                easing.type: Easing.OutCubic
            }
        }
    }

    Rectangle {
        id: mapContainer

        visible: !(root.pipWindowOpen && root.pipWindowContent === "map" && root.videoFocused)
        x: root.videoFocused ? root.pipMargin : 0
        y: root.videoFocused ? bottomBar.y - (root.missionGraphOpen ? root.missionGraphDrawerHeight : 0) - root.pipHeight - root.pipBottomMargin : topBar.height
        width: root.videoFocused ? root.pipWidth : root.width - (root.telemetryPanelOpen ? root.rightPanelWidth : 0)
        height: root.videoFocused ? root.pipHeight : Math.max(0, bottomBar.y - topBar.height - (root.missionGraphOpen ? root.missionGraphDrawerHeight : 0))
        color: root.darkTheme ? "#11161b" : "#f8fbff"
        radius: root.videoFocused ? 16 : 0
        opacity: root.videoFocused ? 0.98 : 1.0
        clip: true
        z: root.videoFocused ? 30 : 1
        layer.enabled: root.preflightChecklistOpen
        layer.effect: MultiEffect {
            blurEnabled: true
            blur: 0.85
            blurMax: 32
        }

        FlyMap {
            id: flyMap

            anchors.fill: parent
            vehicleConnected: root.vehicleConnected
            vehicle: root.vehicle
            missionWaypoints: root.mavlinkObject ? root.mavlinkObject.missionWaypoints : []
            mission3dWaypoints: root.mavlinkObject ? root.mavlinkObject.missionElevationWaypoints : []
            mapViewMode: root.mapViewMode
            compactControls: root.videoFocused
            joystickAvailable: typeof backend !== "undefined" && backend ? backend.joystickAvailable : false
            joystickEnabled: typeof backend !== "undefined" && backend ? backend.joystickEnabled : false
            onMapContextMenuRequested: function(x, y) {
                root.openMapMissionMenu(flyMap, x, y)
            }
            onJoystickEnabledRequested: function(enabled) {
                root.setJoystickControlEnabled(enabled)
            }
        }

        MouseArea {
            id: mapPipMouse
            anchors.fill: parent
            z: 100
            enabled: root.videoFocused && !root.switchingViews
            visible: root.videoFocused
            hoverEnabled: true
            cursorShape: Qt.PointingHandCursor
            onClicked: root.showMapFullScreen()
        }

        Rectangle {
            width: 56
            height: 28
            radius: 6
            anchors.left: parent.left
            anchors.bottom: parent.bottom
            anchors.margins: 10
            z: 120
            visible: root.videoFocused && !root.pipWindowOpen
            color: "#dd101820"
            border.color: root.videoControlIconColor

            Canvas {
                id: mapPopOutIcon
                anchors.centerIn: parent
                width: 18
                height: 18

                onPaint: {
                    var ctx = getContext("2d")
                    ctx.reset()
                    ctx.strokeStyle = root.videoControlIconColor
                    ctx.lineWidth = 2
                    ctx.lineCap = "round"
                    ctx.lineJoin = "round"
                    ctx.beginPath()
                    ctx.moveTo(3, 7)
                    ctx.lineTo(3, 15)
                    ctx.lineTo(11, 15)
                    ctx.stroke()
                    ctx.beginPath()
                    ctx.moveTo(8, 3)
                    ctx.lineTo(15, 3)
                    ctx.lineTo(15, 10)
                    ctx.moveTo(15, 3)
                    ctx.lineTo(7, 11)
                    ctx.stroke()
                }
            }

            MouseArea {
                anchors.fill: parent
                cursorShape: Qt.PointingHandCursor
                onClicked: root.openPipWindow("map")
            }
        }
        Behavior on x {
            enabled: !root.instantMapResize
            NumberAnimation { duration: root.switchDuration; easing.type: Easing.OutCubic }
        }
        Behavior on y {
            enabled: !root.instantMapResize && !root.missionGraphResizing
            NumberAnimation { duration: root.switchDuration; easing.type: Easing.OutCubic }
        }
        Behavior on width {
            enabled: !root.instantMapResize && !root.telemetryPanelResizing
            NumberAnimation { duration: root.switchDuration; easing.type: Easing.OutCubic }
        }
        Behavior on height {
            enabled: !root.instantMapResize && !root.missionGraphResizing
            NumberAnimation { duration: root.switchDuration; easing.type: Easing.OutCubic }
        }
        Behavior on radius { NumberAnimation { duration: root.switchDuration; easing.type: Easing.OutCubic } }
        Behavior on opacity { NumberAnimation { duration: root.switchDuration; easing.type: Easing.OutCubic } }
    }

    Menu {
        id: mapMissionMenu

        parent: Overlay.overlay
        width: 164
        padding: 4

        background: Rectangle {
            radius: 4
            color: root.darkTheme ? "#f20b1018" : "#f8fbff"
            border.color: root.darkTheme ? "#2b3a52" : "#b9c9d8"
            border.width: 1
        }

        MissionMenuItem {
            text: "Read"
            enabled: root.vehicleConnected
            onTriggered: root.requestVehicleMissionLoad()
        }

        MissionMenuItem {
            text: "Write"
            enabled: root.vehicleConnected
            onTriggered: root.requestVehicleMissionWrite()
        }

        MissionMenuItem {
            text: "Clear"
            enabled: root.mavlinkObject && (root.vehicleConnected || root.mavlinkObject.missionWaypoints.length > 0)
            onTriggered: root.requestVehicleMissionClear()
        }
    }

    component MissionMenuItem: MenuItem {
        id: missionMenuItem

        width: mapMissionMenu.width - (mapMissionMenu.padding * 2)
        height: 38
        hoverEnabled: true

        contentItem: Text {
            text: missionMenuItem.text
            color: !missionMenuItem.enabled
                   ? (root.darkTheme ? "#708198" : "#7d8ea3")
                   : missionMenuItem.down || missionMenuItem.hovered ? "#ffffff"
                   : root.darkTheme ? "#f4f8ff" : "#0f213b"
            font.pixelSize: 12
            font.bold: true
            verticalAlignment: Text.AlignVCenter
            leftPadding: 14 + (missionMenuItem.down ? 3 : missionMenuItem.hovered ? 4 : 0)
            rightPadding: 14

            Behavior on leftPadding { NumberAnimation { duration: 110; easing.type: Easing.OutCubic } }
        }

        background: Rectangle {
            radius: 3
            color: missionMenuItem.down
                   ? (root.darkTheme ? "#1b344b" : "#006f95")
                   : missionMenuItem.hovered && missionMenuItem.enabled ? (root.darkTheme ? "#13263a" : "#008fb8")
                   : "#00000000"
        }
    }

    FileDialog {
        id: mapMissionWriteDialog

        title: "Select mission waypoint file"
        currentFolder: (typeof backend !== "undefined" && backend.missionsDirectoryUrl)
                       ? backend.missionsDirectoryUrl()
                       : ""
        nameFilters: [ "Waypoint files (*.waypoints *.txt)", "All files (*)" ]
        fileMode: FileDialog.OpenFile
        onAccepted: {
            if (!root.mavlinkObject)
                return

            root.showActionStatus("Mission write requested")
            root.mavlinkObject.uploadMissionFile(selectedFile)
        }
    }

    Rectangle {
        id: videoContainer

        visible: !(root.pipWindowOpen && root.pipWindowContent === "video" && !root.videoFocused)
        x: root.videoFocused ? 0 : root.videoPipHidden ? 0 : mapContainer.x + root.pipMargin
        y: root.videoFocused ? topBar.height : root.videoPipHidden ? mapContainer.y + mapContainer.height - root.pipHiddenHandleHeight : mapContainer.y + mapContainer.height - root.pipHeight - root.pipBottomMargin
