        Canvas {
            id: rollArc
            anchors.fill: parent
            z: 6
            property real rollValue: altitudeClimbPanel.rollDeg
            onRollValueChanged: requestPaint()
            onWidthChanged: requestPaint()
            onHeightChanged: requestPaint()
            onPaint: {
                var ctx = getContext("2d")
                ctx.reset()

                var cx = width / 2
                var cy = height * 0.36
                var radius = Math.min(width * 0.34, height * 0.23)
                ctx.strokeStyle = "#edf5ff"
                ctx.fillStyle = "#edf5ff"
                ctx.lineWidth = 1.8
                ctx.lineCap = "round"
                ctx.font = "bold 8px sans-serif"
                ctx.textAlign = "center"
                ctx.textBaseline = "middle"

                ctx.beginPath()
                ctx.arc(cx, cy, radius, Math.PI * 1.10, Math.PI * 1.90)
                ctx.stroke()

                for (var mark = -180; mark <= 180; mark += 10) {
                    var angle = (-90 + mark - rollValue) * Math.PI / 180
                    var normalizedAngle = angle
                    while (normalizedAngle < 0)
                        normalizedAngle += Math.PI * 2
                    while (normalizedAngle >= Math.PI * 2)
                        normalizedAngle -= Math.PI * 2

                    if (normalizedAngle < Math.PI * 1.04 || normalizedAngle > Math.PI * 1.96)
                        continue

                    var major = Math.abs(mark) % 30 === 0 || mark === 0
                    var inner = radius - (major ? 9 : 6)
                    var outer = radius
                    ctx.beginPath()
                    ctx.moveTo(cx + Math.cos(angle) * inner, cy + Math.sin(angle) * inner)
                    ctx.lineTo(cx + Math.cos(angle) * outer, cy + Math.sin(angle) * outer)
                    ctx.stroke()

                    if (major && mark !== 0) {
                        var labelRadius = radius - 13
                        ctx.fillText(Math.abs(mark), cx + Math.cos(angle) * labelRadius, cy + Math.sin(angle) * labelRadius)
                    }
                }

                ctx.fillStyle = "#ff2548"
                ctx.beginPath()
                ctx.moveTo(cx, cy - radius - 2)
                ctx.lineTo(cx - 7, cy - radius + 9)
                ctx.lineTo(cx + 7, cy - radius + 9)
                ctx.closePath()
                ctx.fill()
            }
        }

        Item {
            id: fixedAircraft
            anchors.centerIn: parent
            z: 8
            width: 132
            height: 56

            Rectangle {
                anchors.verticalCenter: parent.verticalCenter
                anchors.right: centerMark.left
