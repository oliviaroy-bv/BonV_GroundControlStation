                    ctx.lineWidth = 4
                    ctx.lineCap = "round"
                    ctx.lineJoin = "round"
                    ctx.beginPath()
                    ctx.moveTo(width / 2, height / 2 - 2)
                    ctx.lineTo(width - 8, height / 2 + 14)
                    ctx.moveTo(width / 2, height / 2 - 2)
                    ctx.lineTo(8, height / 2 + 14)
                    ctx.stroke()
                }
            }
        }

        Canvas {
            anchors.fill: parent
            z: 7
            onPaint: {
                var ctx = getContext("2d")
                ctx.reset()
                ctx.strokeStyle = "#edf5ff"
                ctx.lineWidth = 2
                ctx.lineCap = "round"
                var cy = height / 2
                ctx.beginPath()
                ctx.moveTo(12, cy)
                ctx.lineTo(26, cy)
                ctx.moveTo(width - 26, cy)
                ctx.lineTo(width - 12, cy)
                ctx.stroke()
            }
        }

