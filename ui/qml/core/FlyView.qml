            Canvas {
                anchors.fill: parent
                opacity: 0.26
                onPaint: {
                    var ctx = getContext("2d")
                    ctx.reset()
                    var g = ctx.createRadialGradient(width / 2, height / 2, width * 0.08, width / 2, height / 2, width * 0.74)
                    g.addColorStop(0, "rgba(255,255,255,0)")
                    g.addColorStop(0.58, "rgba(0,0,0,0.05)")
                    g.addColorStop(1, "rgba(0,0,0,0.58)")
                    ctx.fillStyle = g
                    ctx.fillRect(0, 0, width, height)

                    var topShade = ctx.createLinearGradient(0, 0, 0, height)
                    topShade.addColorStop(0, "rgba(255,255,255,0.18)")
                    topShade.addColorStop(0.18, "rgba(255,255,255,0.04)")
                    topShade.addColorStop(0.56, "rgba(0,0,0,0)")
                    topShade.addColorStop(1, "rgba(0,0,0,0.18)")
                    ctx.fillStyle = topShade
                    ctx.fillRect(0, 0, width, height)
                }
            }
        }

