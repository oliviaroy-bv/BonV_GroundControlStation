                    ctx.strokeStyle = root.videoControlIconColor
                    ctx.lineWidth = 2.6
                    ctx.lineCap = "round"
                    ctx.lineJoin = "round"

                    ctx.beginPath()
                    ctx.moveTo(4, 9)
                    ctx.lineTo(4, 18)
                    ctx.quadraticCurveTo(4, 20, 6, 20)
                    ctx.lineTo(15, 20)
                    ctx.quadraticCurveTo(17, 20, 17, 18)
                    ctx.lineTo(17, 13)
                    ctx.stroke()

                    ctx.beginPath()
                    ctx.moveTo(10, 4)
                    ctx.lineTo(19, 4)
                    ctx.lineTo(19, 13)
                    ctx.stroke()

                    ctx.beginPath()
                    ctx.moveTo(19, 4)
                    ctx.lineTo(10, 13)
                    ctx.stroke()
