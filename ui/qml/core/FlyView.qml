        clip: true

        Behavior on anchors.rightMargin { NumberAnimation { duration: 220; easing.type: Easing.OutCubic } }

        readonly property real rollDeg: root.finiteNumber(root.vehicle ? root.vehicle.roll * 180 / Math.PI : 0, 0)
        readonly property real pitchDeg: root.finiteNumber(root.vehicle ? root.vehicle.pitch * 180 / Math.PI : 0, 0)
