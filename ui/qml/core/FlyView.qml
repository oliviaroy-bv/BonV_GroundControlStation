                transformOrigin: Item.Center

                Behavior on y { NumberAnimation { duration: 120; easing.type: Easing.OutCubic } }
                Behavior on rotation { NumberAnimation { duration: 120; easing.type: Easing.OutCubic } }

                Rectangle {
                    x: 0
                    y: 0
                    width: parent.width
                    height: parent.height / 2
                    gradient: Gradient {
                        GradientStop { position: 0.0; color: "#02265a" }
                        GradientStop { position: 0.34; color: "#0a4f9f" }
                        GradientStop { position: 0.72; color: "#398fd8" }
                        GradientStop { position: 1.0; color: "#8ccaf5" }
                    }
                }

                Rectangle {
                    x: 0
                    y: parent.height / 2
                    width: parent.width
                    height: parent.height / 2
                    gradient: Gradient {
                        GradientStop { position: 0.0; color: "#7ab80a" }
                        GradientStop { position: 0.34; color: "#4c8f08" }
                        GradientStop { position: 0.72; color: "#236604" }
                        GradientStop { position: 1.0; color: "#0d3d02" }
