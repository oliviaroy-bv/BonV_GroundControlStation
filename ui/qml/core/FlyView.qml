                Rectangle {
                    anchors.horizontalCenter: parent.horizontalCenter
                    y: parent.height / 2 - 1
                    width: parent.width
                    height: 3
                    color: "#ff2548"
                }

                Repeater {
                    model: 49
                    delegate: Item {
                        readonly property int pitchMark: altitudeClimbPanel.pitchLadderBase + (modelData - 24) * 10
                        readonly property real markY: horizonMotion.height / 2 - pitchMark * altitudeClimbPanel.pitchScale
                        x: 0
                        y: markY - 10
                        width: horizonMotion.width
                        height: 20

                        Rectangle {
                            anchors.horizontalCenter: parent.horizontalCenter
                            anchors.verticalCenter: parent.verticalCenter
                            width: pitchMark === 0 ? 78 : 46
                            height: pitchMark === 0 ? 2 : 1
                            color: pitchMark === 0 ? "#1da03d" : "#edf5ff"
                            opacity: 0.86
                        }

                        Text {
                            visible: pitchMark !== 0
                            anchors.right: parent.horizontalCenter
                            anchors.rightMargin: 28
                            anchors.verticalCenter: parent.verticalCenter
                            text: pitchMark
                            color: "#edf5ff"
                            font.pixelSize: 9
                            font.bold: true
                            style: Text.Outline
                            styleColor: "#80000000"
                        }

                        Text {
                            visible: pitchMark !== 0
                            anchors.left: parent.horizontalCenter
                            anchors.leftMargin: 28
                            anchors.verticalCenter: parent.verticalCenter
