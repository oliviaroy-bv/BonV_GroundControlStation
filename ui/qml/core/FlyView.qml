    Connections {
        target: root.mavlinkObject

        function onMissionWaypointsChanged() {
            var waypoints = root.mavlinkObject ? root.mavlinkObject.missionWaypoints : []
            var elevationWaypoints = root.mavlinkObject ? root.mavlinkObject.missionElevationWaypoints : []
            flyMap.missionWaypoints = waypoints
            flyMap.mission3dWaypoints = elevationWaypoints
            if (root.pipWindowContent === "map" && poppedMapLoader.item) {
                poppedMapLoader.item.missionWaypoints = waypoints
                poppedMapLoader.item.mission3dWaypoints = elevationWaypoints
            }
            if (!waypoints || waypoints.length === 0) {
                root.missionGraphOpen = false
                missionGraphWindow.close()
            }
        }

        function onMissionElevationWaypointsChanged() {
            var elevationWaypoints = root.mavlinkObject ? root.mavlinkObject.missionElevationWaypoints : []
            flyMap.mission3dWaypoints = elevationWaypoints
            if (root.pipWindowContent === "map" && poppedMapLoader.item) {
                poppedMapLoader.item.mission3dWaypoints = elevationWaypoints
            }
        }

        function onUploadedHomeLocationChanged() {
            root.openUploadedHomeResetPrompt()
        }

        function onMissionStatusChanged(status) {
            root.showActionStatus(status)
        }

        function onCommandRejected(command, reason) {
            if (command === 400) {
                root.waitingForArmFailureDetail = true
                var armMessage = "Arm/disarm command " + reason + " by autopilot. Check the vehicle status message for the exact pre-arm reason."
                root.addVehicleMessage(armMessage, "error")
                root.showVehicleCommandError(armMessage)
            } else if (command === 209) {
                root.waitingForMotorTestFailureDetail = true
                var motorMessage = "Motor test command " + reason + " by autopilot. The vehicle must usually be disarmed, safety cleared, and propellers removed."
                root.addVehicleMessage(motorMessage, "error")
                root.showVehicleCommandError(motorMessage)
            }
        }

        function onMissionUploadFinished(success, message) {
            if (root.autoGeneratedMissionLoadPending) {
                root.autoGeneratedMissionLoadPending = false
                if (!success && message.indexOf("Mission loaded on map") === 0)
                    return
            }

            root.missionUploadDialogSuccess = success
            root.missionUploadDialogText = message
            root.addVehicleMessage(message, success ? "info" : "error")
            missionUploadDialog.open()
        }
    }

    Connections {
        target: root.vehicle

        function onArmedChanged() {
            root.clearArmCommandFailureState()
        }

        function onStatusTextReceived(message) {
            root.showActionStatus(message)
            root.addVehicleMessage(message)

            if (root.isPositiveVehicleStatus(message)) {
                if (root.isArmStatusMessage(message))
                    root.showVehicleCommandInfo(message)
                if (root.waitingForArmFailureDetail)
                    root.clearArmCommandFailureState()
                return
            }

            if (root.waitingForArmFailureDetail && root.isArmRelatedVehicleStatus(message)) {
                root.waitingForArmFailureDetail = false
                root.showVehicleCommandError(message)
            } else if (root.waitingForMotorTestFailureDetail && root.isMotorTestRelatedVehicleStatus(message)) {
                root.waitingForMotorTestFailureDetail = false
                root.showVehicleCommandError(message)
            }
        }
    }

    Connections {
        target: root.videoObject

        function onErrorStringChanged() {
            if (!root.videoObject)
                return
            var message = root.videoObject.errorString
            if (message.length === 0) {
                root.lastCameraErrorText = ""
                return
            }
            if (root.rtspLink.length > 0)
                root.showCameraError(message)
        }
    }

