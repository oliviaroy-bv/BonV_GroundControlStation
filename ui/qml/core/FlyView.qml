            Repeater {
                model: [-60, -45, -30, -15, 0, 15, 30, 45, 60]
                delegate: Item {
                    readonly property real heading: (headingStrip.centerHeading + modelData + 360) % 360
                    x: headingStrip.width / 2 + modelData * headingStrip.pixelsPerDegree - width / 2
                    y: 0
