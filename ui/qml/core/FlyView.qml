    component MissionElevationDrawer: Rectangle {
        id: drawer

        property bool open: false
        property bool darkTheme: true
        property bool popOutEnabled: true
        property real zoomScale: 1.0
        property var waypoints: []
        property var terrainProfile: []
        readonly property var profilePoints: buildProfile()
        readonly property bool hasTerrainProfile: terrainProfile && terrainProfile.length > 0
        readonly property real totalDistanceMeters: profilePoints.length > 0 ? profilePoints[profilePoints.length - 1].distance : 0
        readonly property real minAltitude: altitudeBound(true)
        readonly property real maxAltitude: altitudeBound(false)
        readonly property real altitudeGain: climbGain()

        signal closeRequested()
        signal popOutRequested()

        color: darkTheme ? "#f20a1018" : "#f8fbff"
        border.color: darkTheme ? "#26384a" : "#bdd0e2"
        border.width: 1
        clip: true

        function numericValue(value, fallbackValue) {
            var numberValue = Number(value)
            return isFinite(numberValue) ? numberValue : fallbackValue
        }

        function waypointField(waypoint, fieldName, fallbackValue) {
            if (!waypoint || waypoint[fieldName] === undefined || waypoint[fieldName] === null)
                return fallbackValue
            return waypoint[fieldName]
        }

        function distanceMeters(firstLat, firstLon, secondLat, secondLon) {
            var earthRadiusMeters = 6371000.0
            var firstLatRadians = firstLat * Math.PI / 180
            var secondLatRadians = secondLat * Math.PI / 180
            var deltaLatRadians = (secondLat - firstLat) * Math.PI / 180
            var deltaLonRadians = (secondLon - firstLon) * Math.PI / 180
            var a = Math.sin(deltaLatRadians / 2) * Math.sin(deltaLatRadians / 2)
                    + Math.cos(firstLatRadians) * Math.cos(secondLatRadians)
                    * Math.sin(deltaLonRadians / 2) * Math.sin(deltaLonRadians / 2)
            return earthRadiusMeters * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a))
        }

        function terrainAtDistance(distance) {
            var terrainPoints = terrainProfile || []
            if (terrainPoints.length === 0)
                return NaN

            if (distance <= numericValue(terrainPoints[0].distance, 0))
                return numericValue(terrainPoints[0].terrain, NaN)

            for (var i = 1; i < terrainPoints.length; ++i) {
                var previousDistance = numericValue(terrainPoints[i - 1].distance, NaN)
                var currentDistance = numericValue(terrainPoints[i].distance, NaN)
                if (!isFinite(previousDistance) || !isFinite(currentDistance))
                    continue
                if (distance > currentDistance)
                    continue

                var previousTerrain = numericValue(terrainPoints[i - 1].terrain, NaN)
                var currentTerrain = numericValue(terrainPoints[i].terrain, NaN)
                if (!isFinite(previousTerrain) || !isFinite(currentTerrain))
                    return NaN

                var span = Math.max(0, currentDistance - previousDistance)
                var fraction = span > 0 ? Math.max(0, Math.min(1, (distance - previousDistance) / span)) : 0
                return previousTerrain + ((currentTerrain - previousTerrain) * fraction)
            }

            return numericValue(terrainPoints[terrainPoints.length - 1].terrain, NaN)
        }

        function isRelativeAltitudeFrame(frame) {
            return frame === 3 || frame === 6
        }

        function isTerrainAltitudeFrame(frame) {
            return frame === 10 || frame === 11
        }

        function planAltitudeAmsl(rawAltitude, frame, distance) {
            if (!hasTerrainProfile)
                return rawAltitude

            if (isTerrainAltitudeFrame(frame)) {
                var terrainHeight = terrainAtDistance(distance)
                return isFinite(terrainHeight) ? terrainHeight + rawAltitude : rawAltitude
            }

            if (isRelativeAltitudeFrame(frame)) {
                var homeTerrainHeight = terrainAtDistance(0)
                return isFinite(homeTerrainHeight) ? homeTerrainHeight + rawAltitude : rawAltitude
            }

            return rawAltitude
        }

        function buildProfile() {
            var points = []
            var source = waypoints || []
            var distance = 0
            var previousPoint = null

            for (var i = 0; i < source.length; ++i) {
                var waypoint = source[i]
                var lat = numericValue(waypointField(waypoint, "lat", NaN), NaN)
                var lon = numericValue(waypointField(waypoint, "lon", NaN), NaN)
                var rawAlt = numericValue(waypointField(waypoint, "alt", NaN), NaN)
                var frame = numericValue(waypointField(waypoint, "frame", 0), 0)
                if (!isFinite(lat) || !isFinite(lon) || !isFinite(rawAlt))
                    continue

                if (previousPoint)
                    distance += distanceMeters(previousPoint.lat, previousPoint.lon, lat, lon)

                points.push({
                    "lat": lat,
                    "lon": lon,
                    "alt": planAltitudeAmsl(rawAlt, frame, distance),
                    "rawAlt": rawAlt,
                    "frame": frame,
                    "distance": distance,
                    "seq": waypointField(waypoint, "seq", points.length + 1)
                })
                previousPoint = points[points.length - 1]
            }

            return points
        }

        function altitudeBound(minimum) {
            if (profilePoints.length === 0)
                return 0

            var value = profilePoints[0].alt
            for (var i = 1; i < profilePoints.length; ++i)
                value = minimum ? Math.min(value, profilePoints[i].alt) : Math.max(value, profilePoints[i].alt)
            return value
        }

        function climbGain() {
            var gain = 0
            for (var i = 1; i < profilePoints.length; ++i)
                gain += Math.max(0, profilePoints[i].alt - profilePoints[i - 1].alt)
            return gain
        }

        function distanceText(meters) {
            if (meters >= 1000)
                return (meters / 1000).toFixed(2) + " km"
            return meters.toFixed(0) + " m"
        }

        function altitudeText(meters) {
            return meters.toFixed(0) + " m"
        }

        function setZoomScale(value) {
            zoomScale = Math.max(1.0, Math.min(8.0, value))
            profileCanvas.requestPaint()
        }

        Rectangle {
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: parent.top
            height: 28
            color: drawer.darkTheme ? "#0b141f" : "#eaf2f9"
            border.color: drawer.darkTheme ? "#1f3042" : "#c7d8e7"
            border.width: 1

            RowLayout {
                anchors.fill: parent
                anchors.leftMargin: 12
                anchors.rightMargin: 8
                spacing: 12

                Text {
                    text: "ELEVATION PROFILE"
                    color: "#00c7df"
                    font.pixelSize: 10
                    font.bold: true
                    verticalAlignment: Text.AlignVCenter
                }

                Text {
                    text: "Mission altitude"
                    color: drawer.darkTheme ? "#8196b7" : "#526680"
                    font.pixelSize: 9
                    verticalAlignment: Text.AlignVCenter
                }

                Item { Layout.fillWidth: true }

                Text {
                    text: "Distance: " + drawer.distanceText(drawer.totalDistanceMeters)
                    color: drawer.darkTheme ? "#dce8f4" : "#1c2b3d"
                    font.pixelSize: 9
                    verticalAlignment: Text.AlignVCenter
                }

                Text {
                    text: "Max: " + drawer.altitudeText(drawer.maxAltitude)
                    color: drawer.darkTheme ? "#dce8f4" : "#1c2b3d"
                    font.pixelSize: 9
                    verticalAlignment: Text.AlignVCenter
                }

                Text {
                    text: "Min: " + drawer.altitudeText(drawer.minAltitude)
                    color: drawer.darkTheme ? "#dce8f4" : "#1c2b3d"
                    font.pixelSize: 9
                    verticalAlignment: Text.AlignVCenter
                }

                Text {
                    text: "Gain: " + drawer.altitudeText(drawer.altitudeGain)
                    color: drawer.darkTheme ? "#dce8f4" : "#1c2b3d"
                    font.pixelSize: 9
                    verticalAlignment: Text.AlignVCenter
                }

                RowLayout {
                    spacing: 6

                    Rectangle {
                        Layout.preferredWidth: 18
                        Layout.preferredHeight: 2
                        color: "#168cff"
                    }

                    Text {
                        text: "PLAN"
                        color: drawer.darkTheme ? "#a9bfd3" : "#526680"
                        font.pixelSize: 9
                        font.bold: true
                    }

                    Rectangle {
                        Layout.preferredWidth: 18
                        Layout.preferredHeight: 2
                        color: "#24d18b"
                    }

                    Text {
                        text: drawer.hasTerrainProfile ? "TERRAIN" : "NO DEM"
                        color: drawer.hasTerrainProfile ? (drawer.darkTheme ? "#a9bfd3" : "#526680") : "#6b7888"
                        font.pixelSize: 9
                        font.bold: true
                    }
                }

                Button {
                    id: elevationDrawerPopOutButton

                    Layout.preferredWidth: 24
                    Layout.preferredHeight: 24
                    padding: 0
                    flat: true
                    hoverEnabled: true
                    visible: drawer.popOutEnabled
                    ToolTip.visible: hovered
                    ToolTip.text: "Pop out elevation profile"
                    onHoveredChanged: elevationDrawerPopOutIcon.requestPaint()
                    contentItem: Canvas {
                        id: elevationDrawerPopOutIcon

                        anchors.centerIn: parent
                        width: 15
                        height: 15
                        onPaint: {
                            var ctx = getContext("2d")
                            ctx.reset()
                            ctx.strokeStyle = elevationDrawerPopOutButton.hovered ? "#ffffff" : "#8ea3b8"
                            ctx.lineWidth = 1.6
                            ctx.lineCap = "round"
                            ctx.lineJoin = "round"
                            ctx.beginPath()
                            ctx.moveTo(2, 6)
                            ctx.lineTo(2, 13)
                            ctx.lineTo(9, 13)
                            ctx.stroke()
                            ctx.beginPath()
                            ctx.moveTo(6, 2)
                            ctx.lineTo(13, 2)
                            ctx.lineTo(13, 9)
                            ctx.moveTo(13, 2)
                            ctx.lineTo(6, 9)
                            ctx.stroke()
                        }
                    }
                    background: Rectangle {
                        radius: 3
                        color: elevationDrawerPopOutButton.down ? "#27384a" : elevationDrawerPopOutButton.hovered ? "#1b2a3b" : "#00000000"
                    }
                    onClicked: drawer.popOutRequested()
                }

                Button {
                    id: elevationDrawerCloseButton

                    Layout.preferredWidth: 24
                    Layout.preferredHeight: 24
                    padding: 0
                    flat: true
                    hoverEnabled: true
                    ToolTip.visible: hovered
                    ToolTip.text: "Close elevation profile"
                    contentItem: Text {
                        text: "x"
                        color: elevationDrawerCloseButton.hovered ? "#ffffff" : "#8ea3b8"
                        font.pixelSize: 14
                        font.bold: true
                        horizontalAlignment: Text.AlignHCenter
                        verticalAlignment: Text.AlignVCenter
                    }
                    background: Rectangle {
                        radius: 3
                        color: elevationDrawerCloseButton.down ? "#27384a" : elevationDrawerCloseButton.hovered ? "#1b2a3b" : "#00000000"
                    }
                    onClicked: drawer.closeRequested()
                }
            }
        }

        Canvas {
            id: profileCanvas

            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            anchors.topMargin: 28
            anchors.leftMargin: 8
            anchors.rightMargin: 8
            anchors.bottomMargin: 6

            onWidthChanged: requestPaint()
            onHeightChanged: requestPaint()

            PinchArea {
                id: graphPinchArea

                anchors.fill: parent
                z: 2
                property real startZoomScale: 1.0
                onPinchStarted: function(pinch) {
                    startZoomScale = drawer.zoomScale
                    pinch.accepted = true
                }
                onPinchUpdated: function(pinch) {
                    drawer.setZoomScale(startZoomScale * pinch.scale)
                    pinch.accepted = true
                }
            }

            Connections {
                target: drawer
                function onProfilePointsChanged() {
                    profileCanvas.requestPaint()
                }
                function onOpenChanged() {
                    profileCanvas.requestPaint()
                }
                function onDarkThemeChanged() {
                    profileCanvas.requestPaint()
                }
                function onZoomScaleChanged() {
                    profileCanvas.requestPaint()
                }
                function onTerrainProfileChanged() {
                    profileCanvas.requestPaint()
                }
                function onHasTerrainProfileChanged() {
                    profileCanvas.requestPaint()
                }
            }

            MouseArea {
                anchors.fill: parent
                z: 1
                acceptedButtons: Qt.NoButton
                hoverEnabled: true
                onWheel: function(wheel) {
                    if (wheel.angleDelta.y > 0)
                        drawer.setZoomScale(drawer.zoomScale * 1.15)
                    else if (wheel.angleDelta.y < 0)
                        drawer.setZoomScale(drawer.zoomScale / 1.15)
                    wheel.accepted = true
                }
            }

            onPaint: {
                var ctx = getContext("2d")
                ctx.reset()

                var points = drawer.profilePoints
                var terrainPoints = drawer.terrainProfile || []
                var left = 56
                var right = 30
                var top = 28
                var bottom = 28
                var plotWidth = width - left - right
                var plotHeight = height - top - bottom

                ctx.fillStyle = drawer.darkTheme ? "#071019" : "#eef5fb"
                ctx.fillRect(0, 0, width, height)

                if (points.length === 0 || plotWidth <= 0 || plotHeight <= 0) {
                    ctx.fillStyle = drawer.darkTheme ? "#8799ad" : "#596a7a"
                    ctx.font = "11px sans-serif"
                    ctx.textAlign = "center"
                    ctx.fillText("No mission elevation data", width / 2, height / 2)
                    return
                }

                var fullMinAlt = drawer.minAltitude
                var fullMaxAlt = drawer.maxAltitude
                for (var terrainRangeIndex = 0; terrainRangeIndex < terrainPoints.length; ++terrainRangeIndex) {
                    var terrainRangeValue = drawer.numericValue(terrainPoints[terrainRangeIndex].terrain, NaN)
                    if (!isFinite(terrainRangeValue))
                        continue
                    fullMinAlt = Math.min(fullMinAlt, terrainRangeValue)
                    fullMaxAlt = Math.max(fullMaxAlt, terrainRangeValue)
                }
                var centerAlt = (fullMinAlt + fullMaxAlt) / 2
                var fullRangeAlt = Math.max(10, fullMaxAlt - fullMinAlt)
                var rangeAlt = (fullRangeAlt * 1.22) / drawer.zoomScale
                var minAlt = centerAlt - rangeAlt / 2
                var maxAlt = centerAlt + rangeAlt / 2
                var terrainDistance = terrainPoints.length > 0 ? drawer.numericValue(terrainPoints[terrainPoints.length - 1].distance, 0) : 0
                var totalDistance = Math.max(1, drawer.totalDistanceMeters, terrainDistance)
                var axisColor = drawer.darkTheme ? "#34465a" : "#b9c9d8"
                var gridColor = drawer.darkTheme ? "#182637" : "#d7e2ec"
                var labelColor = drawer.darkTheme ? "#8ea3b8" : "#526680"

                ctx.strokeStyle = gridColor
                ctx.lineWidth = 1
                ctx.font = "9px Consolas"
                ctx.fillStyle = labelColor
                ctx.textAlign = "right"
                ctx.textBaseline = "middle"

                for (var row = 0; row <= 3; ++row) {
                    var y = top + (plotHeight * row / 3)
                    var altLabel = maxAlt - (rangeAlt * row / 3)
                    ctx.beginPath()
                    ctx.moveTo(left, y)
                    ctx.lineTo(width - right, y)
                    ctx.stroke()
                    ctx.fillText(altLabel.toFixed(0), left - 7, y)
                }

                ctx.textAlign = "center"
                ctx.textBaseline = "top"
                for (var col = 0; col <= 4; ++col) {
                    var x = left + (plotWidth * col / 4)
                    var dist = totalDistance * col / 4
                    ctx.beginPath()
                    ctx.moveTo(x, top)
                    ctx.lineTo(x, top + plotHeight)
                    ctx.stroke()
                    ctx.fillText(dist >= 1000 ? (dist / 1000).toFixed(1) : dist.toFixed(0), x, top + plotHeight + 5)
                }

                ctx.strokeStyle = axisColor
                ctx.lineWidth = 1
                ctx.strokeRect(left, top, plotWidth, plotHeight)

                var plotInset = 8
                var drawablePlotWidth = Math.max(1, plotWidth - (plotInset * 2))

                function pointX(point) {
                    return left + plotInset + (point.distance / totalDistance) * drawablePlotWidth
                }

                function pointY(point) {
                    return top + (1 - ((point.alt - minAlt) / rangeAlt)) * plotHeight
                }

                function terrainX(point) {
                    return left + plotInset + (drawer.numericValue(point.distance, 0) / totalDistance) * drawablePlotWidth
                }

                function terrainY(point) {
                    return top + (1 - ((drawer.numericValue(point.terrain, minAlt) - minAlt) / rangeAlt)) * plotHeight
                }

                ctx.save()
                ctx.beginPath()
                ctx.rect(left, top, plotWidth, plotHeight)
                ctx.clip()

                if (terrainPoints.length > 0) {
                    var terrainGradient = ctx.createLinearGradient(0, top, 0, top + plotHeight)
                    terrainGradient.addColorStop(0, drawer.darkTheme ? "rgba(36, 209, 139, 0.24)" : "rgba(28, 160, 104, 0.18)")
                    terrainGradient.addColorStop(1, drawer.darkTheme ? "rgba(36, 209, 139, 0.02)" : "rgba(28, 160, 104, 0.0)")

                    ctx.beginPath()
                    ctx.moveTo(terrainX(terrainPoints[0]), top + plotHeight)
                    for (var terrainFillIndex = 0; terrainFillIndex < terrainPoints.length; ++terrainFillIndex)
                        ctx.lineTo(terrainX(terrainPoints[terrainFillIndex]), terrainY(terrainPoints[terrainFillIndex]))
                    ctx.lineTo(terrainX(terrainPoints[terrainPoints.length - 1]), top + plotHeight)
                    ctx.closePath()
                    ctx.fillStyle = terrainGradient
                    ctx.fill()

                }

                var fillGradient = ctx.createLinearGradient(0, top, 0, top + plotHeight)
                fillGradient.addColorStop(0, drawer.darkTheme ? "rgba(239, 68, 68, 0.55)" : "rgba(220, 38, 38, 0.34)")
                fillGradient.addColorStop(1, drawer.darkTheme ? "rgba(91, 20, 20, 0.0)" : "rgba(220, 38, 38, 0.0)")

                ctx.beginPath()
                ctx.moveTo(pointX(points[0]), top + plotHeight)
                for (var fillIndex = 0; fillIndex < points.length; ++fillIndex)
                    ctx.lineTo(pointX(points[fillIndex]), pointY(points[fillIndex]))
                ctx.lineTo(pointX(points[points.length - 1]), top + plotHeight)
                ctx.closePath()
                ctx.fillStyle = fillGradient
                ctx.fill()

                if (terrainPoints.length > 0) {
                    ctx.beginPath()
                    ctx.moveTo(terrainX(terrainPoints[0]), terrainY(terrainPoints[0]))
                    for (var terrainLineIndex = 1; terrainLineIndex < terrainPoints.length; ++terrainLineIndex)
                        ctx.lineTo(terrainX(terrainPoints[terrainLineIndex]), terrainY(terrainPoints[terrainLineIndex]))
                    ctx.strokeStyle = "#24d18b"
                    ctx.lineWidth = 2.2
                    ctx.stroke()
                }

                ctx.beginPath()
                ctx.moveTo(pointX(points[0]), pointY(points[0]))
                for (var lineIndex = 1; lineIndex < points.length; ++lineIndex)
                    ctx.lineTo(pointX(points[lineIndex]), pointY(points[lineIndex]))
                ctx.strokeStyle = "#e53935"
                ctx.lineWidth = 2
                ctx.stroke()

                ctx.restore()

                if (!drawer.hasTerrainProfile) {
                    ctx.fillStyle = drawer.darkTheme ? "#6f7f91" : "#6a7886"
                    ctx.font = "9px sans-serif"
                    ctx.textAlign = "right"
                    ctx.textBaseline = "top"
                    ctx.fillText("DEM unavailable", width - right, top + 4)
                }

                ctx.fillStyle = drawer.darkTheme ? "#061018" : "#ffffff"
                ctx.strokeStyle = "#00c7df"
                ctx.lineWidth = 1.4
                ctx.font = "9px Consolas"
                ctx.textAlign = "center"
                ctx.textBaseline = "bottom"

                var markerStride = Math.max(1, Math.ceil(points.length / 12))
                for (var markerIndex = 0; markerIndex < points.length; ++markerIndex) {
                    if (markerIndex !== 0 && markerIndex !== points.length - 1 && markerIndex % markerStride !== 0)
                        continue

                    var markerX = pointX(points[markerIndex])
                    var markerY = pointY(points[markerIndex])
                    markerX = Math.max(left + 5, Math.min(width - right - 5, markerX))
                    markerY = Math.max(top + 7, Math.min(top + plotHeight - 5, markerY))
                    ctx.beginPath()
                    ctx.arc(markerX, markerY, 4, 0, Math.PI * 2)
                    ctx.fill()
                    ctx.stroke()

                    ctx.fillStyle = drawer.darkTheme ? "#cfeeff" : "#0f2a3c"
                    ctx.fillText(points[markerIndex].seq, markerX, markerY - 7)
                    ctx.fillStyle = drawer.darkTheme ? "#061018" : "#ffffff"
                }

                ctx.fillStyle = labelColor
                ctx.textAlign = "left"
                ctx.textBaseline = "top"
                ctx.fillText("m", 5, 2)
                ctx.textAlign = "right"
                ctx.fillText(totalDistance >= 1000 ? "km" : "m", width - 2, top + plotHeight + 5)
            }
        }
    }

    Window {
        id: telemetryPopoutWindow

        width: root.rightPanelWidth
        height: Math.max(260, telemetryPanel.height)
        minimumWidth: 260
        minimumHeight: 260
        title: "BonV GCS - Telemetry"
        color: root.darkTheme ? "#11161b" : "#f8fbff"
        flags: Qt.Window
               | Qt.WindowTitleHint
               | Qt.WindowSystemMenuHint
               | Qt.WindowMinimizeButtonHint
               | Qt.WindowMaximizeButtonHint
               | Qt.WindowCloseButtonHint

        VerticalTelemetryPanel {
            anchors.fill: parent
            expanded: true
            darkTheme: root.darkTheme
            panelWidth: parent ? parent.width : root.rightPanelWidth
            flightModeText: root.vehicle ? root.vehicle.flightMode : "--"
            relativeAltitudeText: root.metersText(root.vehicle ? root.vehicle.altitude : null)
            homeDistanceText: root.metersText(root.vehicle ? root.vehicle.distanceToHome : null)
            climbText: root.speedText(root.vehicle ? root.vehicle.climb : null)
            groundSpeedText: root.speedText(root.vehicle ? root.vehicle.groundspeed : null)
            flightTimeText: root.timeText(root.vehicle ? root.vehicle.flightTime : null)
            flightDistanceText: root.metersText(root.vehicle ? root.vehicle.flightDistance : null)
            rollText: root.radianDegreeText(root.vehicle ? root.vehicle.roll : null)
            pitchText: root.radianDegreeText(root.vehicle ? root.vehicle.pitch : null)
            yawText: root.radianDegreeText(root.vehicle ? root.vehicle.yaw : null)
            batteryText: root.percentText(root.vehicle ? root.vehicle.battery : null)
            satellitesText: root.integerText(root.vehicle ? root.vehicle.satellites : null)
            gpsFixText: root.integerText(root.vehicle ? root.vehicle.gpsFix : null)
            latitudeText: root.coordinateText(root.vehicle ? root.vehicle.latitude : null)
            longitudeText: root.coordinateText(root.vehicle ? root.vehicle.longitude : null)
            clockText: root.currentClockText
            messages: root.vehicleMessages
            onToggleRequested: telemetryPopoutWindow.close()
            onPopOutRequested: root.openTelemetryPopout()
        }
    }

    Window {
        id: missionGraphWindow

        width: 900
        height: 280
        minimumWidth: 560
        minimumHeight: 180
        title: "BonV GCS - Elevation Profile"
        color: root.darkTheme ? "#11161b" : "#f8fbff"
        flags: Qt.Window
               | Qt.WindowTitleHint
               | Qt.WindowSystemMenuHint
               | Qt.WindowMinimizeButtonHint
               | Qt.WindowMaximizeButtonHint
               | Qt.WindowCloseButtonHint

        MissionElevationDrawer {
            anchors.fill: parent
            open: true
            darkTheme: root.darkTheme
            popOutEnabled: false
            waypoints: root.mavlinkObject ? root.mavlinkObject.missionElevationWaypoints : []
            terrainProfile: root.mavlinkObject ? root.mavlinkObject.missionTerrainProfile : []
            onCloseRequested: missionGraphWindow.close()
        }
    }

    Window {
        id: pipWindow

        width: 960
        height: 540
        minimumWidth: 480
        minimumHeight: 270
        title: root.pipWindowContent === "map" ? "BonV GCS - Map" : "BonV GCS - Video"
        color: root.darkTheme ? "#11161b" : "#f8fbff"
        flags: Qt.Window
               | Qt.WindowTitleHint
               | Qt.WindowSystemMenuHint
               | Qt.WindowMinimizeButtonHint
               | Qt.WindowMaximizeButtonHint
               | Qt.WindowCloseButtonHint

        onClosing: root.closePipWindowState()

        Loader {
            id: poppedMapLoader

            anchors.fill: parent
            active: root.pipWindowOpen
            sourceComponent: root.pipWindowContent === "map" ? poppedMap : poppedVideo
        }
    }

    Component {
        id: poppedMap

        FlyMap {
            vehicleConnected: root.vehicleConnected
            vehicle: root.vehicle
            missionWaypoints: root.mavlinkObject ? root.mavlinkObject.missionWaypoints : []
            mission3dWaypoints: root.mavlinkObject ? root.mavlinkObject.missionElevationWaypoints : []
            mapViewMode: root.mapViewMode
            joystickAvailable: typeof backend !== "undefined" && backend ? backend.joystickAvailable : false
            joystickEnabled: typeof backend !== "undefined" && backend ? backend.joystickEnabled : false
            onJoystickEnabledRequested: function(enabled) {
                root.setJoystickControlEnabled(enabled)
            }
        }
    }

    Component {
        id: poppedVideo

        Item {
            Video {
                anchors.fill: parent
                videoObject: root.videoObject
                rtspLink: root.rtspLink
                cameraName: root.cameraName
            }

            GimbalControlPad {
                anchors.right: parent.right
                anchors.bottom: parent.bottom
                anchors.rightMargin: 22
                anchors.bottomMargin: 58
                z: 10
                darkTheme: root.darkTheme
                videoObject: root.videoObject
                visible: root.cameraConnected
            }
        }
    }

}
